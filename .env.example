# Copy to .env for local development. .env is in .gitignore.
DATABASE_URL=sqlite:///breakrides.db
ALLOWED_EMAIL_DOMAIN=scu.edu
SECURE_COOKIES=false
# Verification emails: "console" prints them in the server log (local only).
# In production use "resend" with a key from resend.com.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=BreakRides <onboarding@resend.dev>
