# Copy to .env for local development. .env is in .gitignore.
DATABASE_URL=sqlite:///breakrides.db
ALLOWED_EMAIL_DOMAIN=scu.edu
SECURE_COOKIES=false
# Emails: "console" prints them in the server log (local only).
# In production use "smtp" (e.g. Gmail + app password) or "resend".
EMAIL_BACKEND=console
EMAIL_FROM=BreakRides <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
